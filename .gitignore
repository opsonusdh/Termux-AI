# Provider API keys and the OAuth client secret — never commit these.
# The rest of config/ IS source and must stay tracked: api.keys.template,
# capability_registry.json, whatsapp_filters.json and config.json.
config/api.keys
config/api.keys.bak
config/google_oauth.json
config/config.json
config/*.tmp
